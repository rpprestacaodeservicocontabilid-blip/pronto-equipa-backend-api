# ============================================================================
# CONFIGURAÇÃO DE SERVIDOR
# ============================================================================
PORT=3333
NODE_ENV=development

# ============================================================================
# FRONTEND & CORS
# ============================================================================

# URL do frontend para CORS
FRONTEND_URL=http://localhost:3333

# ============================================================================
# CONFIGURAÇÃO DE BANCO DE DADOS
# ============================================================================

# Dialect do banco de dados (postgres | mysql | oracle)
# Padrão: postgres
DB_DIALECT=postgres

# ============================================================================
# PostgreSQL (quando DB_DIALECT=postgres)
# ============================================================================

# Opção 1: Usar DATABASE_URL (recomendado para produção)
# DATABASE_URL=postgresql://user:password@localhost:5432/peladeiro

# Opção 2: Configuração individual
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=peladeiro

# ============================================================================
# MySQL (quando DB_DIALECT=mysql)
# ============================================================================

# Descomente as linhas abaixo para MySQL e comente as de PostgreSQL acima
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=peladeiro

# ============================================================================
# Oracle (quando DB_DIALECT=oracle)
# ============================================================================

# Descomente as linhas abaixo para Oracle e comente as de PostgreSQL acima
# DB_HOST=localhost
# DB_PORT=1521
# DB_USER=system
# DB_PASSWORD=oracle
# DB_NAME=XE

# ============================================================================
# POOL DE CONEXÕES (Recomendado para Escalabilidade)
# ============================================================================

# Máximo de conexões no pool (aumentar em produção)
DB_POOL_MAX=10

# Mínimo de conexões no pool
DB_POOL_MIN=2

# Tempo de espera para adquirir conexão (em ms)
DB_POOL_ACQUIRE=30000

# Tempo de inatividade antes de fechar conexão (em ms)
DB_POOL_IDLE=10000

# ============================================================================
# LOGGING
# ============================================================================

# Habilitar SQL logging (true | false)
DB_LOGGING=false

# Nível de log (debug | info | warn | error)
LOG_LEVEL=info

# ============================================================================
# AUTENTICAÇÃO & SEGURANÇA
# ============================================================================

# Chave secreta JWT (MUDE EM PRODUÇÃO)
JWT_SECRET=your-secret-key-here-change-in-production

# Tempo de expiração do token JWT (exemplo: 1h, 7d)
JWT_EXPIRES_IN=1h

# ============================================================================
# RATE LIMITING (Segurança)
# ============================================================================

# Limite de requisições por IP em janela de tempo
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# CACHE / REDIS (Escalabilidade)
# ============================================================================

# URL de conexão com Redis (opcional)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Payslips: PDFs are private; use a durable shared object store for multi-node production.
PAYSLIPS_WORKER_ENABLED=false
PAYSLIPS_STORAGE_PATH=./storage/payslips
# Optional S3-compatible storage (when configured, it replaces local filesystem storage).
PAYSLIPS_S3_ENDPOINT=
PAYSLIPS_S3_BUCKET=
PAYSLIPS_S3_REGION=us-east-1
PAYSLIPS_S3_ACCESS_KEY=
PAYSLIPS_S3_SECRET_KEY=
PAYSLIPS_EVENTS_URL=
PAYSLIPS_EVENTS_TOKEN=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peladeiro
# Ou:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=peladeiro

# ============ MySQL ============
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=peladeiro

# ============ Oracle ============
# DB_DIALECT=oracle
# DB_HOST=localhost
# DB_PORT=1521
# DB_USER=system
# DB_PASSWORD=oracle
# DB_NAME=XE

# Payroll integrations (workers are opt-in; no in-memory financial queue)
PAYROLL_WORKER_ENABLED=false
PAYROLL_TENANT_CONCURRENCY=2
PAYROLL_ENGINE_URL=
PAYROLL_LEGAL_RULES_URL=
PAYROLL_EVENTS_URL=
PAYROLL_INTEGRATION_TOKEN=

# Payments PII protection: use a unique 32-byte key encoded as 64 hex characters.
PAYMENTS_PII_ENCRYPTION_KEY=
