# APP_NAME=peladeiro

# PORT=3333

JWT_EXPIRES_IN=24h

# LOG_LEVEL=debug

# SWAGGER_ENABLED=true

# CORS_ORIGIN=http://localhost:3333

# # Optional HTTP notification providers (required in production for OTP delivery)
# AUTH_EMAIL_PROVIDER_URL=
# AUTH_SMS_PROVIDER_URL=
# AUTH_NOTIFICATION_API_KEY=

# REDIS_PASSWORD=redis123

# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_PORT=5672
# RABBITMQ_UI_PORT=15672






# Copie este ficheiro para .env e preencha os valores necessários.
# Nunca use os valores de exemplo em produção. Segredos reais não devem
# ser versionados.

# -----------------------------------------------------------------------------
# Aplicação e servidor
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=prontoequipas
APP_VERSION=1.0.0
APP_URL=http://localhost:3333
APP_ENV=development
PORT=3333
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=10000
# Variável legada usada por src/config/env.ts, Docker Compose e healthcheck.
APP_PORT=3001
DOCKERFILE=Dockerfile
NETWORK_NAME=peladeiro-network

# -----------------------------------------------------------------------------
# Frontend, CORS e sessão no browser
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3333
CORS_ORIGIN=http://localhost:3333
REACT_APP_API_URL=http://localhost:3333
AUTH_BROWSER_SESSION_COOKIE_SUFFIX=

# -----------------------------------------------------------------------------
# Autenticação e segurança
# -----------------------------------------------------------------------------
# Obrigatório. Em produção use pelo menos 32 caracteres aleatórios.
JWT_SECRET=secret
JWT_EXPIRES_IN=24h
# Nome legado encontrado na configuração de testes.
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=prontoequipas
JWT_AUDIENCE=prontoequipas-app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_AUTH_MAX=20
SOCKET_MAX_CONN_PER_IP=30

# -----------------------------------------------------------------------------
# Base de dados
# -----------------------------------------------------------------------------
# Use mysql ou postgres em produção; sqlite é útil em desenvolvimento/testes.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prontoequipas
DB_USER=postgres
DB_PASSWORD=
DB_STORAGE=./database/dev.sqlite
DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# -----------------------------------------------------------------------------
# Redis e filas
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PORT_EXTERNAL=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=prontoequipas:
RABBITMQ_URL=
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_PREFETCH=10
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_MS=5000

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Logging e armazenamento geral
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_MAX_FILE_MB=10

# -----------------------------------------------------------------------------
# Email e SMS para autenticação
# -----------------------------------------------------------------------------
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
EMAIL_FROM_NAME=ProntoEquipas
EMAIL_FROM_ADDRESS=noreply@prontoequipas.com
AUTH_EMAIL_PROVIDER_URL=
AUTH_SMS_PROVIDER_URL=
AUTH_NOTIFICATION_API_KEY=

# -----------------------------------------------------------------------------
# Notificações da plataforma (canais EMAIL e SMS)
# -----------------------------------------------------------------------------
NOTIFICATIONS_EMAIL_URL=
NOTIFICATIONS_EMAIL_TOKEN=
NOTIFICATIONS_SMS_URL=
NOTIFICATIONS_SMS_TOKEN=
NOTIFICATIONS_EVENTS_TOKEN=
NOTIFICATIONS_CALLBACK_SECRET=
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_CLEANUP_ENABLED=false
NOTIFICATIONS_DAILY_QUOTA=10000
NOTIFICATIONS_BULLMQ_ENABLED=false

# -----------------------------------------------------------------------------
# Telemetria
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
TELEMETRY_TRACE_HEADER=traceparent

# -----------------------------------------------------------------------------
# Folhas salariais (payslips)
# -----------------------------------------------------------------------------
PAYSLIPS_WORKER_ENABLED=false
PAYSLIPS_STORAGE_PATH=./storage/payslips
PAYSLIPS_S3_ENDPOINT=
PAYSLIPS_S3_BUCKET=
PAYSLIPS_S3_REGION=us-east-1
PAYSLIPS_S3_ACCESS_KEY=
PAYSLIPS_S3_SECRET_KEY=
PAYSLIPS_EVENTS_URL=
PAYSLIPS_EVENTS_TOKEN=

# -----------------------------------------------------------------------------
# Documentos, uploads e antivírus
# -----------------------------------------------------------------------------
DOCUMENTS_WORKER_ENABLED=false
DOCUMENTS_DEFAULT_QUOTA_BYTES=107374182400
DOCUMENTS_MAX_FILE_BYTES=104857600
DOCUMENTS_MULTIPART_PART_BYTES=8388608
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_S3_ACCESS_KEY=
DOCUMENTS_S3_SECRET_KEY=
DOCUMENTS_CLAMAV_HOST=
DOCUMENTS_CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# Integrações de processamento salarial
# -----------------------------------------------------------------------------
PAYROLL_WORKER_ENABLED=false
PAYROLL_TENANT_CONCURRENCY=2
PAYROLL_ENGINE_URL=
PAYROLL_LEGAL_RULES_URL=
PAYROLL_EVENTS_URL=
PAYROLL_INTEGRATION_TOKEN=

# -----------------------------------------------------------------------------
# Auditoria e integridade de evidências
# -----------------------------------------------------------------------------
AUDIT_WORKER_ENABLED=false
AUDIT_QUEUE_ENABLED=false
AUDIT_POLL_INTERVAL_MS=10000
AUDIT_EVENTS_ENABLED=false
AUDIT_HTTP_CAPTURE_ENABLED=false
AUDIT_EVENT_PREFIX=prontoequipas
AUDIT_EVIDENCE_ROOT=storage/private/audit
AUDIT_ANCHOR_ROOT=
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_SIGNING_KEY_ID=audit-key-v1
AUDIT_TRUSTED_PUBLIC_KEYS={}
AUDIT_ALERT_RECIPIENTS_JSON={}

# -----------------------------------------------------------------------------
# Onboarding, subscrições e faturação da plataforma
# -----------------------------------------------------------------------------
ONBOARDING_REQUIRED_DOCUMENTS=0
SUBSCRIPTIONS_WORKER_ENABLED=false
SUBSCRIPTIONS_SWEEP_INTERVAL_MS=300000
SUBSCRIPTIONS_EVENTS_URL=
SUBSCRIPTIONS_EVENTS_TOKEN=
PLATFORM_BILLING_EVENTS_URL=
PLATFORM_BILLING_EVENTS_TOKEN=
PLATFORM_BILLING_PROVIDER_WEBHOOK_SECRET=
PLATFORM_BILLING_SUBSCRIPTION_TAX_VERSION=
SUBSCRIPTIONS_BILLING_EVENTS_TOKEN=

# -----------------------------------------------------------------------------
# Pagamentos
# -----------------------------------------------------------------------------
# Chave AES-256: exatamente 32 bytes codificados em 64 caracteres hexadecimais.
PAYMENTS_PII_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Simulações e migrações de auditoria
# -----------------------------------------------------------------------------
SIMULATIONS_WORKER_ENABLED=false

# -----------------------------------------------------------------------------
# Testes de integração (opcionais)
# -----------------------------------------------------------------------------
PAYROLL_TEST_POSTGRES_URL=
AUDIT_TEST_POSTGRES_URL=
AUDIT_PARTITION_DATABASE_URL=
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=prontoequipas_test
DEBUG=
SWAGGER_ENABLED=false
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Ferramentas operacionais e Docker Compose (opcionais)
# -----------------------------------------------------------------------------
DB_PORT_EXTERNAL=3306
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
REDIS_INSPECTOR_PORT=8081

# Usadas pelo script scripts/audit-load.cjs; AUDIT_LOAD_CONFIRMED deve ser YES.
AUDIT_LOAD_BASE_URL=http://127.0.0.1:3000/api/v1/
AUDIT_LOAD_CONFIRMED=
AUDIT_LOAD_TOKEN=
AUDIT_LOAD_COMPANY_ID=
AUDIT_LOAD_CONCURRENCY=20
AUDIT_LOAD_REQUESTS=200
