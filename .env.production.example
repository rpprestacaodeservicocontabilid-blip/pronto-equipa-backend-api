# Copie para .env.production. Os segredos são ficheiros em ./secrets/ e não
# devem ser guardados no Git nem passados como valores no Compose.
APP_IMAGE=prontoequipas-api:local
NODE_IMAGE=node:22-bookworm-slim
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine

NODE_ENV=production
APP_NAME=prontoequipas
APP_BIND_IP=127.0.0.1
APP_PORT=3333
# Origem HTTPS do frontend autorizado a aceder à API.
FRONTEND_URL=
DB_DIALECT=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=prontoequipas
DB_USER=prontoequipas
DB_MIGRATION_USER=prontoequipas_migrator
DB_ACL_USER=prontoequipas_acl
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
LOG_LEVEL=info
LOG_DIR=/tmp/logs
REDIS_URL=redis://redis:6379
REDIS_PREFIX=prontoequipas:

# Opcional: ative os workers e configure endpoints conforme os serviços usados.
PAYSLIPS_WORKER_ENABLED=false
PAYSLIPS_S3_ENDPOINT=
PAYSLIPS_S3_BUCKET=
PAYSLIPS_S3_REGION=us-east-1
PAYSLIPS_EVENTS_URL=
PAYSLIPS_EVENTS_TOKEN=
DOCUMENTS_WORKER_ENABLED=false
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_CLAMAV_HOST=
DOCUMENTS_CLAMAV_PORT=3310
PAYROLL_WORKER_ENABLED=false
PAYROLL_ENGINE_URL=
PAYROLL_LEGAL_RULES_URL=
PAYROLL_EVENTS_URL=
PAYROLL_INTEGRATION_TOKEN=
AUDIT_WORKER_ENABLED=true
AUDIT_QUEUE_ENABLED=true
AUDIT_EVENTS_ENABLED=true
AUDIT_SIGNING_KEY_ID=audit-ed25519-v1
AUDIT_ALERT_RECIPIENTS_JSON=
AUDIT_ANCHOR_HOST_PATH=
SUBSCRIPTIONS_WORKER_ENABLED=false

# Caminhos relativos à raiz do projeto para ficheiros criados fora do Git.
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
DB_PASSWORD_FILE=./secrets/db_password
DB_MIGRATION_PASSWORD_FILE=./secrets/db_migration_password
DB_ACL_PASSWORD_FILE=./secrets/db_acl_password
JWT_SECRET_FILE=./secrets/jwt_secret
REDIS_PASSWORD_FILE=./secrets/redis_password
PAYMENTS_PII_ENCRYPTION_KEY_FILE=./secrets/payments_pii_encryption_key
AUDIT_SIGNING_PRIVATE_KEY_FILE=./secrets/audit_signing_private_key
