{
  "name": "peladeiro-api",
  "version": "1.0.0",
  "description": "peladeiro aplication interface",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/main/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/server.js",
    "sequelize": "sequelize-cli",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:audit": "jest --runInBand src/tests/integration/audit.test.ts src/tests/integration/audit-engine.test.ts src/tests/integration/audit-postgres.test.ts",
    "test:audit:load": "node scripts/audit-load.cjs",
    "test:audit:sql": "node --test scripts/audit-migrations.test.cjs",
    "audit:partitions": "node scripts/audit-partitions.cjs",
    "db:migrate:production": "sequelize-cli db:migrate --config src/config/sequelize-production.cjs --migrations-path src/infra/database/migrations --env production",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "architecture:check": "node scripts/audit-module-architecture.cjs --strict",
    "architecture:report": "node scripts/audit-module-architecture.cjs --write"
  },
  "keywords": [
    "peladeiro"
  ],
  "author": "@peladeiro",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.4.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.6",
    "cron": "^3.1.7",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "events": "^3.3.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "mysql2": "^3.6.5",
    "oracledb": "^6.3.0",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "stripe": "^22.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.3.0",
    "@types/oracledb": "^6.2.8",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
