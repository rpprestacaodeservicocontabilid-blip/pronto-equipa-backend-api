# ============================================================================
# CONFIGURAÇÃO DOCKER - Copie para .env para usar com Docker
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=peladeiro
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis Configuration
REDIS_URL=redis://:redis123@redis:6379
REDIS_PASSWORD=redis123

# Authentication
JWT_SECRET=your-secure-jwt-secret-change-in-production-12345
JWT_EXPIRES_IN=24h

# PgAdmin (Database Management)
PGADMIN_EMAIL=admin@peladeiro.com
PGADMIN_PASSWORD=admin123

# Habilitados para desenvolvimento
# Desabilitados para produção
DB_LOGGING=false
NODE_ENV=development

# Payslips: private file storage for single-node Compose; configure S3/MinIO for shared production storage.
PAYSLIPS_WORKER_ENABLED=false
PAYSLIPS_S3_ENDPOINT=
PAYSLIPS_S3_BUCKET=
PAYSLIPS_S3_REGION=us-east-1
PAYSLIPS_S3_ACCESS_KEY=
PAYSLIPS_S3_SECRET_KEY=
PAYSLIPS_EVENTS_URL=
PAYSLIPS_EVENTS_TOKEN=
